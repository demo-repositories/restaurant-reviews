# Sanity (read)
NEXT_PUBLIC_SANITY_PROJECT_ID=s6y3amel
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity write token (Editor role) — used to persist agent conversations.
# Create at https://sanity.io/manage  → Project → API → Tokens
SANITY_API_WRITE_TOKEN=

# Sanity Agent Context MCP — for the chat route
# Read token (Viewer role) — generate via:
#   npx sanity tokens add "Agent Context" --role=viewer --yes --json
SANITY_API_READ_TOKEN=
# MCP URL: copy from your Agent Context document in Studio, or use the base URL:
#   https://api.sanity.io/v2026-03-03/agent-context/s6y3amel/production
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-03-03/agent-context/s6y3amel/production

# LLM
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-5
